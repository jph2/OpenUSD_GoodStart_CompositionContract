#usda 1.0
(
    customLayerData = {
        string "cc:context" = "asset variants; defaults on public root"
        string "cc:owner" = "asset:Cone@1"
        string "cc:profile" = "CC-EXAMPLE-01/0.1.1"
        string "cc:role" = "VariLyr"
    }
)

over "Cone" (
    variants = {
        string Finish = "Yellow"
        string Size = "Normal"
    }
    prepend variantSets = ["Size", "Finish"]
)
{
    variantSet "Size" = {
        "Large" {
            double3 xformOp:scale = (2, 2, 2)
            uniform token[] xformOpOrder = ["xformOp:scale"]

        }
        "Normal" {
            double3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:scale"]

        }
        "Tall" {
            double3 xformOp:scale = (1, 1, 2)
            uniform token[] xformOpOrder = ["xformOp:scale"]

        }
    }
    variantSet "Finish" = {
        "Blue" {
            over "Geometry" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Cone/Looks/Blue>
            }

        }
        "Red" {
            over "Geometry" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Cone/Looks/Red>
            }

        }
        "Yellow" {
            over "Geometry" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Cone/Looks/Yellow>
            }

        }
    }
}

