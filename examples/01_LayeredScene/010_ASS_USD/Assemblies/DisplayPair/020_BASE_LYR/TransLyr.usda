#usda 1.0
(
    customLayerData = {
        string "cc:context" = "unconditional"
        string "cc:owner" = "assembly:DisplayPair@1"
        string "cc:profile" = "CC-EXAMPLE-01/0.1.1"
        string "cc:role" = "TransLyr"
    }
)

over "DisplayPair"
{
    over "CubePart"
    {
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-70, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    over "ConePart"
    {
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (70, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

