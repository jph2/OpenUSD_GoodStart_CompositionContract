#usda 1.0
(
    customLayerData = {
        string "cc:context" = "Layout branches"
        string "cc:owner" = "scene:LayeredScene@1"
        string "cc:profile" = "CC-EXAMPLE-01/0.1.1"
        string "cc:role" = "VariLyr"
    }
)

over "World" (
    variants = {
        string Layout = "Normal"
    }
    prepend variantSets = "Layout"
)
{
    variantSet "Layout" = {
        "Exploded" {
            over "Cube01"
            {
                over "Adjustment"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    over "Asset" (
                        variants = {
                            string Finish = "Yellow"
                            string Size = "Normal"
                        }
                    )
                    {
                    }
                }
            }

            over "Cube02"
            {
                over "Adjustment"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 80)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    over "Asset" (
                        variants = {
                            string Finish = "Red"
                            string Size = "Tall"
                        }
                    )
                    {
                    }
                }
            }

            over "Cone01"
            {
                over "Adjustment"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    over "Asset" (
                        variants = {
                            string Finish = "Yellow"
                            string Size = "Normal"
                        }
                    )
                    {
                    }
                }
            }

            over "Pair01"
            {
                over "Adjustment"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    over "Asset" (
                        variants = {
                            string Palette = "Warm"
                        }
                    )
                    {
                    }
                }
            }

        }
        "Normal" {
            over "Cube01"
            {
                over "Adjustment"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    over "Asset" (
                        variants = {
                            string Finish = "Red"
                            string Size = "Normal"
                        }
                    )
                    {
                    }
                }
            }

            over "Cube02"
            {
                over "Adjustment"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    over "Asset" (
                        variants = {
                            string Finish = "Blue"
                            string Size = "Tall"
                        }
                    )
                    {
                    }
                }
            }

            over "Cone01"
            {
                over "Adjustment"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    over "Asset" (
                        variants = {
                            string Finish = "Yellow"
                            string Size = "Normal"
                        }
                    )
                    {
                    }
                }
            }

            over "Pair01"
            {
                over "Adjustment"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    over "Asset" (
                        variants = {
                            string Palette = "Cool"
                        }
                    )
                    {
                    }
                }
            }

        }
    }
}

