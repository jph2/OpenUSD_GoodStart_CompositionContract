#usda 1.0
over "Asset" (
    prepend variantSets = "Color"
    variants = { string Color = "Red" }
)
{
    variantSet "Color" = {
        "Red" {
            over "Geometry" (prepend apiSchemas = ["MaterialBindingAPI"])
            {
                rel material:binding = </Asset/Looks/Red>
            }
        }
        "Blue" {
            over "Geometry" (prepend apiSchemas = ["MaterialBindingAPI"])
            {
                rel material:binding = </Asset/Looks/Blue>
            }
        }
    }
}
