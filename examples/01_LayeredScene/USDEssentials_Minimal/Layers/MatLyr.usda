#usda 1.0

over "World"
{
    def Scope "Looks" (
        prepend references = @../Assets/Palette.usda@
    )
    {
    }

    over "Cube01"
    {
        over "Geometry" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/Red>
        }
    }

    over "Cone01"
    {
        over "Geometry" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/Blue>
        }
    }
}
