#usda 1.0
(
    customLayerData = {
        string "cc:context" = "unconditional"
        string "cc:owner" = "library:Palette@1"
        string "cc:profile" = "CC-EXAMPLE-01/0.2"
        string "cc:role" = "MatLyr"
    }
    defaultPrim = "Materials"
)

def Scope "Materials"
{
    def Material "Red"
    {
        token outputs:surface.connect = </Materials/Red/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.65, 0.035, 0.025)
            float inputs:metallic = 0
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }

    def Material "Blue"
    {
        token outputs:surface.connect = </Materials/Blue/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.025, 0.18, 0.65)
            float inputs:metallic = 0
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }

    def Material "Yellow"
    {
        token outputs:surface.connect = </Materials/Yellow/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.85, 0.52, 0.025)
            float inputs:metallic = 0
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }

    def Material "Ground"
    {
        token outputs:surface.connect = </Materials/Ground/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.18, 0.2, 0.22)
            float inputs:metallic = 0
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }
}

