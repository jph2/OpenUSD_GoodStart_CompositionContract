#usda 1.0
(
    customLayerData = {
        string "cc:context" = "unconditional"
        string "cc:owner" = "scene:LayeredScene@1"
        string "cc:profile" = "CC-EXAMPLE-01/0.2"
        string "cc:role" = "MatLyr"
    }
)

def "World"
{
    def Scope "Looks"
    {
        def Material "Ground" (
            prepend references = @../010_ASS_USD/MatLib/Palette_v001.usda@</Materials/Ground>
        )
        {
        }
    }

    over "Environment"
    {
        over "Ground" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/Ground>
        }
    }
}

